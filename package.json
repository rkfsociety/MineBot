{
  "name": "minebot",
  "version": "0.1.9",
  "private": true,
  "description": "Minecraft Java Edition bot (mineflayer)",
  "main": "runner.js",
  "scripts": {
    "start": "node runner.js",
    "start:legacy:electron": "electron legacy",
    "dist:legacy:electron": "electron-packager legacy MineBot --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true",
    "dist:legacy:zip": "powershell -NoProfile -Command \"Remove-Item -Force -ErrorAction SilentlyContinue dist\\\\MineBot-win32-x64.zip; Compress-Archive -Path dist\\\\MineBot-win32-x64\\\\* -DestinationPath dist\\\\MineBot-win32-x64.zip\"",
    "dist:legacy:launcher": "pkg legacy/launcher.js --targets node20-win-x64 --output dist\\\\MineBot.exe",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:fast": "tauri build --no-bundle"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "express": "^4.21.2",
    "mineflayer": "^4.37.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "rkfsociety.minebot",
    "productName": "MineBot"
  }
}
