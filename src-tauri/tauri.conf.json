{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineBot",
  "version": "0.2.22",
  "identifier": "rkfsociety.minebot",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:3847/home",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "MineBot",
        "width": 1100,
        "height": 780,
        "resizable": true,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}

